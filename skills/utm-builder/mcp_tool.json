        "type": "string",
        "description": "utm_source"
      },
      "medium": {
        "type": "string",
        "description": "utm_medium"
      },
      "campaign": {
        "type": "string",
        "description": "utm_campaign"
      },
      "term": {
        "type": "string",
        "description": "utm_term"
      },
      "content": {
        "type": "string",
        "description": "utm_content"
      }
