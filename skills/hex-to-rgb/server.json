{
  "name": "io.github.ncreighton/hex-to-rgb",
  "description": "Use this skill to convert a hex color (#rrggbb or #rgb) to RGB values and a css rgb() string. Deterministic, offline.",
  "version": "0.1.0",
  "packages": [
    {
      "registry_type": "pypi_or_git",
      "identifier": "hex-to-rgb",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_skill": {
    "entry": "skill",
    "input_schema": {
      "type": "object",
      "properties": {
        "hex": {
          "type": "string",
          "description": "Hex color, e.g. #1a2b3c"
        }
      },
      "required": [
        "hex"
      ]
    },
    "cost_tier": "free"
  }
}