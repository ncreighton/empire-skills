{
  "name": "io.github.ncreighton/csv-column",
  "description": "Use this skill to extract a single column's values from CSV text by header name or index. Deterministic, offline. For pulling one field out of a spreadsheet export.",
  "version": "0.1.0",
  "packages": [
    {
      "registry_type": "pypi_or_git",
      "identifier": "csv-column",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_skill": {
    "entry": "skill",
    "input_schema": {
      "type": "object",
      "properties": {
        "csv": {
          "type": "string",
          "description": "CSV text"
        },
        "column": {
          "type": "string",
          "description": "Header name or 0-based index"
        }
      },
      "required": [
        "csv",
        "column"
      ]
    },
    "cost_tier": "free"
  }
}