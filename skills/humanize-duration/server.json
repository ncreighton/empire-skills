{
  "name": "io.github.ncreighton/humanize-duration",
  "description": "Use this skill to convert a number of seconds into a human duration like '2h 5m 30s'. Deterministic, offline. For run-times, ETAs, video lengths.",
  "version": "0.1.0",
  "packages": [
    {
      "registry_type": "pypi_or_git",
      "identifier": "humanize-duration",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_skill": {
    "entry": "skill",
    "input_schema": {
      "type": "object",
      "properties": {
        "seconds": {
          "type": "number",
          "description": "Duration in seconds"
        }
      },
      "required": [
        "seconds"
      ]
    },
    "cost_tier": "free"
  }
}