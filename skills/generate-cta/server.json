{
  "name": "io.github.ncreighton/generate-cta",
  "description": "Use this skill to generate N compelling call-to-action lines for a given product or offer description. Uses an LLM. Returns a list of CTA options.",
  "version": "0.1.0",
  "packages": [
    {
      "registry_type": "pypi_or_git",
      "identifier": "generate-cta",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_skill": {
    "entry": "skill",
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Input text"
        },
        "count": {
          "type": "number",
          "description": "How many CTAs (default 5)"
        }
      },
      "required": [
        "text"
      ]
    },
    "cost_tier": "near_free"
  }
}