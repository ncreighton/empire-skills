{
  "name": "io.github.ncreighton/truncate-words",
  "description": "Use this skill to truncate text to a max number of words with an ellipsis (default 50). Deterministic, offline. For excerpts and previews.",
  "version": "0.1.0",
  "packages": [
    {
      "registry_type": "pypi_or_git",
      "identifier": "truncate-words",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_skill": {
    "entry": "skill",
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Input text"
        },
        "words": {
          "type": "number",
          "description": "Max words (default 50)"
        }
      },
      "required": [
        "text"
      ]
    },
    "cost_tier": "free"
  }
}