{
  "name": "io.github.ncreighton/suggest-titles",
  "description": "Use this skill to generate N catchy, SEO-aware title options for an article given its topic or first paragraph. Uses an LLM.",
  "version": "0.1.0",
  "packages": [
    {
      "registry_type": "pypi_or_git",
      "identifier": "suggest-titles",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_skill": {
    "entry": "skill",
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Input text"
        },
        "count": {
          "type": "number",
          "description": "How many titles (default 5)"
        }
      },
      "required": [
        "text"
      ]
    },
    "cost_tier": "near_free"
  }
}