{
  "name": "io.github.ncreighton/base64",
  "description": "Use this skill to base64-encode or -decode text (mode=encode|decode). Deterministic, offline. For tokens, data URIs, and encoding payloads.",
  "version": "0.1.0",
  "packages": [
    {
      "registry_type": "pypi_or_git",
      "identifier": "base64",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_skill": {
    "entry": "skill",
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Input text"
        },
        "mode": {
          "type": "string",
          "description": "encode (default) or decode"
        }
      },
      "required": [
        "text"
      ]
    },
    "cost_tier": "free"
  }
}