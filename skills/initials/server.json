{
  "name": "io.github.ncreighton/initials",
  "description": "Use this skill to get the initials of a name/phrase (first letter of each word, uppercased, capped at max). Deterministic, offline. For avatars/monograms.",
  "version": "0.1.0",
  "packages": [
    {
      "registry_type": "pypi_or_git",
      "identifier": "initials",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_skill": {
    "entry": "skill",
    "input_schema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Input text"
        },
        "max": {
          "type": "number",
          "description": "Max initials (default 3)"
        }
      },
      "required": [
        "text"
      ]
    },
    "cost_tier": "free"
  }
}